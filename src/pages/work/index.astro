---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { featuredProjects } from "../../data/projects";
---

<BaseLayout
  title="Work — Macropinix"
  description="Open-source engineering projects by Mani Kamran, with project details, screenshots, and source repositories."
>
  <Navigation />
  <main id="main-content">
    <section class="work-page">
      <div class="container">
        <p class="section-index">MACROPINIX / PROJECT INDEX</p>
        <h1 class="work-page-title">Work, in the open.</h1>
        <p class="work-page-intro">
          Working software, real interfaces, and the engineering decisions behind them.
          Inspect a project or follow its source.
        </p>

        <div class="work-page-list">
          {featuredProjects.map((project, index) => (
            <ProjectCard project={project} index={index + 1} featured={index === 0} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .work-page {
    min-height: 75vh;
    padding: calc(var(--nav-height) + var(--space-8)) 0 var(--space-8);
  }

  .work-page-title {
    margin-top: var(--space-3);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 1.05;
  }

  .work-page-intro {
    max-width: 39rem;
    margin-top: var(--space-4);
    margin-bottom: var(--space-7);
    color: var(--text-muted);
    font-size: 1.0625rem;
  }
</style>
