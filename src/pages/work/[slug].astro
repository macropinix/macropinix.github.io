---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ProjectShowcase from "../../components/ProjectShowcase.astro";
import { featuredProjects, projects } from "../../data/projects";

// Every project gets a page from one template, so a new project needs a data
// entry only — no new route file to copy.
export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      // Other projects, in priority order, so each page can link onwards.
      related: featuredProjects.filter((p) => p.slug !== project.slug),
    },
  }))) satisfies GetStaticPaths;

const { project, related } = Astro.props;
---

<BaseLayout
  title={`${project.name} — ${project.tagline}`}
  description={project.description}
  type="article"
>
  <Navigation />
  <main id="main-content">
    <section class="project-hero">
      <div class="container">
        <div class="project-meta-bar">
          <span class="project-meta-item">STATUS / {project.status}</span>
          <span class="project-meta-item">SOURCE / {project.source}</span>
          <span class="project-meta-item">SYSTEM / {project.system}</span>
        </div>
        <p class="project-label">PROJECT</p>
        <h1 class="project-name">{project.name}</h1>
        <p class="project-tagline">{project.tagline}</p>
        <p class="project-description">{project.description}</p>
        <ul class="project-tech" role="list">
          {project.technologies.map((tech) => <li>{tech}</li>)}
        </ul>
      </div>
    </section>

    {
      project.screenshots.length > 0 && (
        <ProjectShowcase
          title={project.showcaseTitle}
          description={project.showcaseDescription}
          screenshots={project.screenshots}
        />
      )
    }

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">PROBLEM</h2>
        <p class="project-text">{project.problem}</p>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">APPROACH</h2>
        <p class="project-text">{project.approach}</p>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">ARCHITECTURE</h2>
        <div class="architecture-flow">
          {project.architecture.map((step, index) => (
            <div class="arch-step">
              <span class="arch-label">{step}</span>
              {index < project.architecture.length - 1 && (
                <span class="arch-arrow" aria-hidden="true">↓</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">ENGINEERING DECISIONS</h2>
        <ul class="decision-list" role="list">
          {project.engineeringDecisions.map((decision) => (
            <li class="decision-item">
              <span class="decision-marker" aria-hidden="true">▸</span>
              {decision}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">EVIDENCE</h2>
        <ul class="evidence-list" role="list">
          {project.evidence.map((item) => <li class="evidence-item">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">REPOSITORY</h2>
        <a
          href={project.repository}
          target="_blank"
          rel="noopener noreferrer"
          class="repo-link"
        >
          {project.repository}
        </a>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">NEXT</h2>
        <ul class="related-list" role="list">
          {related.map((item) => (
            <li>
              <a href={`/work/${item.slug}`} class="related-item">
                <span class="related-name">{item.name}</span>
                <span class="related-tagline">{item.tagline}</span>
                <span class="related-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/work" class="btn btn-secondary">All work</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .project-hero {
    padding: calc(var(--nav-height) + var(--space-9)) 0 var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-meta-bar {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .project-meta-item {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--signal);
    margin-bottom: var(--space-3);
  }

  .project-name {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-2);
  }

  .project-tagline {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .project-description {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 36rem;
    margin-bottom: var(--space-6);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-tech li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .project-section {
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-text {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 40rem;
  }

  .architecture-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 40rem;
  }

  .arch-step {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  .arch-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--signal);
    opacity: 0.6;
  }

  .decision-list,
  .evidence-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 40rem;
  }

  .decision-item,
  .evidence-item {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: flex;
    gap: var(--space-2);
  }

  .decision-marker {
    color: var(--signal);
    opacity: 0.7;
  }

  .evidence-item::before {
    content: "▸";
    color: var(--signal);
    opacity: 0.7;
  }

  .repo-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--signal);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--duration-fast) ease;
  }

  .repo-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 40rem;
    margin-bottom: var(--space-6);
  }

  .related-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-layer);
    transition: border-color var(--duration-fast) ease, background var(--duration-fast) ease;
  }

  .related-item:hover {
    border-color: var(--blue-deep);
    background: var(--bg-elevated);
  }

  .related-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .related-tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    flex: 1;
  }

  .related-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--signal);
    opacity: 0.7;
  }
</style>
