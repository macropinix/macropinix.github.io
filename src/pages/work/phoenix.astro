---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ProjectShowcase from "../../components/ProjectShowcase.astro";
import { projects } from "../../data/projects";

const project = projects.find((p) => p.slug === "phoenix")!;

const phoenixScreenshots = [
  {
    src: "https://raw.githubusercontent.com/AdolfMacro/phoenix/main/screenshots/1.png",
    alt: "Phoenix project interface showing tool-building and system implementation",
  },
];
---

<BaseLayout title={`Phoenix — ${project.tagline}`} canonical={`https://macropinix.com/work/${project.slug}`} depth="095" depthStatus="PROCESS">
  <Navigation />
  <main>
    <section class="project-hero">
      <div class="container">
        <div class="project-meta-bar">
          <span class="project-meta-item">STATUS / PUBLIC</span>
          <span class="project-meta-item">SOURCE / PYTHON</span>
          <span class="project-meta-item">SYSTEM / TOOLING</span>
        </div>
        <p class="project-label">PROJECT</p>
        <h1 class="project-name">{project.name}</h1>
        <p class="project-tagline">{project.tagline}</p>
        <p class="project-description">{project.description}</p>
      </div>
    </section>

    <ProjectShowcase
      title="INTERFACE"
      description="Phoenix project interface demonstrating end-to-end tool building workflow and system implementation."
      screenshots={phoenixScreenshots}
    />

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">PROBLEM</h2>
        <p class="project-text">{project.problem}</p>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">APPROACH</h2>
        <p class="project-text">{project.approach}</p>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">ARCHITECTURE</h2>
        <div class="architecture-flow">
          {project.architecture.map((step, index) => (
            <div class="arch-step">
              <span class="arch-label">{step}</span>
              {index < project.architecture.length - 1 && <span class="arch-arrow">↓</span>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">ENGINEERING DECISIONS</h2>
        <ul class="decision-list" role="list">
          {project.engineeringDecisions.map((decision) => (
            <li class="decision-item">
              <span class="decision-marker">▸</span>
              {decision}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">EVIDENCE</h2>
        <ul class="evidence-list" role="list">
          {project.evidence.map((item) => (
            <li class="evidence-item">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">REPOSITORY</h2>
        <a
          href={project.repository}
          target="_blank"
          rel="noopener noreferrer"
          class="repo-link"
        >
          {project.repository}
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .project-hero {
    padding: calc(var(--nav-height) + var(--space-9)) 0 var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-meta-bar {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .project-meta-item {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--signal);
    margin-bottom: var(--space-3);
  }

  .project-name {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-2);
  }

  .project-tagline {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .project-description {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 36rem;
  }

  .project-section {
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-text {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 40rem;
  }

  .architecture-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 24rem;
  }

  .arch-step {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  .arch-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--signal);
    opacity: 0.6;
  }

  .decision-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 40rem;
  }

  .decision-item {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: flex;
    gap: var(--space-2);
  }

  .decision-marker {
    color: var(--signal);
    opacity: 0.7;
  }

  .evidence-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 40rem;
  }

  .evidence-item {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: flex;
    gap: var(--space-2);
  }

  .evidence-item::before {
    content: "▸";
    color: var(--signal);
    opacity: 0.7;
  }

  .repo-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--signal);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--duration-fast) ease;
  }

  .repo-link:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>
