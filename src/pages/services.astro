---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { services } from "../data/services";
---

<BaseLayout title="Services — Macropinix" description="Technical services offered by Mani Kamran.">
  <Navigation />
  <main id="main-content">
    <section class="services-page">
      <div class="container">
        <h1 class="services-page-title">Services</h1>
        <p class="services-page-intro">
          What technical problems can be solved.
        </p>

        <div class="services-page-grid">
          {services.map((service, index) => (
            <article class="service-card">
              <span class="service-index">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="service-title">{service.title}</h3>
              <p class="service-description">{service.description}</p>
              <ul class="service-capabilities" role="list">
                {service.capabilities.map((cap) => (
                  <li>{cap}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="services-page-cta">
          <p>Have a problem that fits?</p>
          <a href="/contact" class="btn btn-primary">Start a Project</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .services-page {
    padding: calc(var(--nav-height) + var(--space-9)) 0 var(--space-9);
  }

  .services-page-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .services-page-intro {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: var(--space-7);
    max-width: 32rem;
  }

  .services-page-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .service-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-layer);
  }

  .service-index {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--signal);
    opacity: 0.6;
    display: block;
    margin-bottom: var(--space-3);
  }

  .service-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .service-description {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .service-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .service-capabilities li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .services-page-cta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .services-page-cta p {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .services-page-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
