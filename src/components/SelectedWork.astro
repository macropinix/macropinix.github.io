---
import ProjectCard from "./ProjectCard.astro";
import { projects, type Project } from "../data/projects";

const selectedSlugs = ["patogh", "eyenv", "visigui", "eye"];
const selectedProjects = selectedSlugs
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is Project => project !== undefined);
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="section-index">01 / SELECTED WORK</p>
        <h2 class="section-title" id="work-title">Software, in the open.</h2>
        <p class="section-intro">
          Each project starts with a concrete problem. Open the case study, inspect
          the interface, or go directly to its source.
        </p>
      </div>
      <a class="text-link" href="/work">
        All projects <span class="text-link__arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="work-list">
      {selectedProjects.map((project, index) => (
        <ProjectCard project={project} index={index + 1} featured={index === 0} />
      ))}
    </div>
  </div>
</section>
