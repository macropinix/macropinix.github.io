<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
    width: 100%;
    padding-top: var(--space-9);
    padding-bottom: var(--space-9);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--signal);
    margin-bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Parallax wrapper. The scroll-linked transform lives here, separate from
     the breathing animation on .hero-logo, so the two never overwrite
     each other's transform. */
  .hero-logo-parallax {
    width: clamp(220px, 28vw, 360px);
    margin-bottom: var(--space-5);
    will-change: transform;
    transform: translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0);
  }

  @media (max-width: 768px) {
    .hero-logo-parallax {
      width: clamp(180px, 55vw, 260px);
    }
  }

  .hero-logo {
    width: 100%;
    height: auto;
    display: block;
    /* Transform/opacity only, so the animation stays on the compositor and
       never triggers layout or repaint. */
    animation: signal-breathe 5s ease-in-out infinite;
  }

  /* Matches the sonar/signal language already used by the hero visuals:
     the mark surfaces, holds, and dims again, like a repeating ping. */
  @keyframes signal-breathe {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.92;
      filter: drop-shadow(0 0 6px rgba(0, 255, 153, 0.25));
    }
    50% {
      transform: translate3d(0, -3px, 0) scale(1.015);
      opacity: 1;
      filter: drop-shadow(0 0 18px rgba(0, 255, 153, 0.55));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo {
      animation: none;
    }

    .hero-logo-parallax {
      transform: none;
    }
  }

  .hero-label::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
