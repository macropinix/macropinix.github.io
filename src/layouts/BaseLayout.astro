---
import "../styles/global.css";

const SITE = "https://macropinix.github.io";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Macropinix is an engineering body of work by Mani Kamran: practical software for data, systems, and interaction.",
  canonical,
  ogImage = "/og-image.png",
  type = "website",
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, SITE).href;
const ogImageURL = new URL(ogImage, SITE).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/macropinix-favicon.svg" />
    <link rel="icon" type="image/png" href="/macropinix-favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f14" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Macropinix" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Macropinix — software built to be inspected." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
