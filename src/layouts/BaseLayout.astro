---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  depth?: string;
  depthLabel?: string;
  depthStatus?: string;
}

const {
  title,
  description = "Python automation, web data extraction, Linux and network tooling by Mani Kamran.",
  canonical = "https://macropinix.github.io",
  ogImage = "/og-image.svg",
  depth,
  depthLabel,
  depthStatus,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/macropinix-favicon.svg" />
    <link rel="icon" type="image/png" href="/macropinix-favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />

    <div class="scan-grid" aria-hidden="true">
      <div class="scan-grid__lines"></div>
      <div class="scan-grid__scan"></div>
    </div>

    {depth && (
      <div class="fixed-indicator" aria-hidden="true">
        <span class="fixed-indicator__depth">DEPTH {depth}</span>
        <span class="fixed-indicator__status">{depthStatus || "SIGNAL ACTIVE"}</span>
      </div>
    )}
  </body>
</html>

<style>
  .fixed-indicator {
    position: fixed;
    bottom: var(--space-5);
    right: var(--space-5);
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    pointer-events: none;
    font-family: var(--font-mono);
  }

  .fixed-indicator__depth {
    font-size: 0.5625rem;
    color: var(--signal);
    opacity: 0.5;
    letter-spacing: 0.1em;
  }

  .fixed-indicator__status {
    font-size: 0.5625rem;
    color: var(--text-dim);
    opacity: 0.4;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .fixed-indicator {
      bottom: var(--space-3);
      right: var(--space-3);
    }
  }
</style>
