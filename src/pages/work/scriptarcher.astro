---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ProjectShowcase from "../../components/ProjectShowcase.astro";
import { projects } from "../../data/projects";

const project = projects.find((p) => p.slug === "scriptarcher")!;

const scriptarcherScreenshots = [
  {
    src: "https://raw.githubusercontent.com/AdolfMacro/ScriptArcher/refs/heads/main/screenshots/1.jpg",
    alt: "ScriptArcher toolkit interface showing security and pentesting utilities",
  },
];
---

<BaseLayout title={`ScriptArcher — ${project.tagline}`} canonical={`https://macropinix.com/work/${project.slug}`} depth="095" depthStatus="SYSTEM ACTIVE">
  <Navigation />
  <main>
    <section class="project-hero">
      <div class="container">
        <div class="project-meta-bar">
          <span class="project-meta-item">STATUS / PUBLIC</span>
          <span class="project-meta-item">SOURCE / PYTHON</span>
          <span class="project-meta-item">SYSTEM / SECURITY</span>
        </div>
        <p class="project-label">PROJECT</p>
        <h1 class="project-name">{project.name}</h1>
        <p class="project-tagline">{project.tagline}</p>
        <p class="project-description">{project.description}</p>
      </div>
    </section>

    <ProjectShowcase
      title="INTERFACE"
      description="ScriptArcher application interface showing the security and pentesting toolkit workflow."
      screenshots={scriptarcherScreenshots}
    />

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">PROBLEM</h2>
        <p class="project-text">{project.problem}</p>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">APPROACH</h2>
        <p class="project-text">{project.approach}</p>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">CAPABILITIES</h2>
        <div class="architecture-flow">
          <div class="arch-step">
            <span class="arch-label">IPv6 FINDER</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">MASS MAILER ATTACK</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">SCAN — PORT / IP / RANGE / POPULAR / SWEEP / ZOMBIE / HALF-OPEN</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">DDoS — ICMP / SMURF / TCP / UDP</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">DEAUTHENTICATION ATTACKS</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">MAC SPOOFING</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">ARP SPOOFING</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">DBM ANALYZER</span>
          </div>
          <div class="arch-step">
            <span class="arch-label">SUBDOMAIN SCANNER</span>
          </div>
        </div>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">TECHNICAL DETAILS</h2>
        <p class="project-text">
          Built with Python. Key libraries include scapy, socket, colorama, requests, and email. Relies on external tooling such as nmap, aircrack-ng, iw, and net-tools for network and wireless operations.
        </p>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">ENGINEERING DECISIONS</h2>
        <ul class="decision-list" role="list">
          <li class="decision-item">
            <span class="decision-marker">▸</span>
            Scapy-based packet crafting for low-level network control
          </li>
          <li class="decision-item">
            <span class="decision-marker">▸</span>
            Nmap integration for scanning workflows
          </li>
          <li class="decision-item">
            <span class="decision-marker">▸</span>
            Modular CLI structure separating discovery, scanning, and attack utilities
          </li>
          <li class="decision-item">
            <span class="decision-marker">▸</span>
            Open-source release with documented installation flow
          </li>
        </ul>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">EVIDENCE</h2>
        <ul class="evidence-list" role="list">
          <li class="evidence-item">Repository available</li>
          <li class="evidence-item">Open source</li>
          <li class="evidence-item">Multiple security utilities</li>
        </ul>
      </div>
    </section>

    <section class="project-section">
      <div class="container">
        <h2 class="section-label">REPOSITORY</h2>
        <a
          href={project.repository}
          target="_blank"
          rel="noopener noreferrer"
          class="repo-link"
        >
          {project.repository}
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .project-hero {
    padding: calc(var(--nav-height) + var(--space-9)) 0 var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-meta-bar {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .project-meta-item {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--signal);
    margin-bottom: var(--space-3);
  }

  .project-name {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-2);
  }

  .project-tagline {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .project-description {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 36rem;
  }

  .project-section {
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-text {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 40rem;
  }

  .architecture-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 40rem;
  }

  .arch-step {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  .arch-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--signal);
    opacity: 0.6;
  }

  .decision-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 40rem;
  }

  .decision-item {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: flex;
    gap: var(--space-2);
  }

  .decision-marker {
    color: var(--signal);
    opacity: 0.7;
  }

  .evidence-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 40rem;
  }

  .evidence-item {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: flex;
    gap: var(--space-2);
  }

  .evidence-item::before {
    content: "▸";
    color: var(--signal);
    opacity: 0.7;
  }

  .repo-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--signal);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--duration-fast) ease;
  }

  .repo-link:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>
