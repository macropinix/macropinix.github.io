---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import SelectedWork from "../components/SelectedWork.astro";
import EngineeringAreas from "../components/EngineeringAreas.astro";
import Lab from "../components/Lab.astro";
import About from "../components/About.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Macropinix — Software built to solve real problems"
  description="Macropinix is an engineering body of work by Mani Kamran: practical software for data, systems, networks, and interaction."
>
  <Navigation />
  <main id="main-content">
    <Hero />
    <SelectedWork />
    <EngineeringAreas />
    <Lab />
    <About />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
