---
import { Image } from "astro:assets";
import heroScene from "../assets/hero-scene.webp";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">MACROPINIX / ENGINEERING BODY OF WORK</p>
      <h1 class="hero-title" id="hero-title">
        I solve problems<br class="desktop-break" /> by building software.
      </h1>
      <p class="hero-description">
        Practical systems, tools, and interfaces—built around real problems and
        shared with the evidence to inspect them.
      </p>
      <div class="hero-actions">
        <a href="#work" class="btn btn-primary">Explore the work <span aria-hidden="true">↘</span></a>
        <a href="https://github.com/AdolfMacro" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          GitHub <span aria-hidden="true">↗</span>
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>
      <ul class="hero-disciplines" aria-label="Engineering disciplines">
        <li>Python</li>
        <li>Linux</li>
        <li>Networking</li>
        <li>Automation</li>
      </ul>
    </div>
    <div class="hero-mark" aria-hidden="true">
      <Image
        src={heroScene}
        alt="A lone engineer working at a computer beneath a canopy of cables."
        class="hero-image"
        widths={[360, 540, 720]}
        sizes="(max-width: 960px) 100vw, 360px"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: min(760px, 92svh);
    display: flex;
    align-items: center;
    padding-block: calc(var(--nav-height) + var(--space-7)) var(--space-8);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(210px, 0.44fr);
    align-items: center;
    gap: clamp(var(--space-6), 8vw, var(--space-9));
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-5);
  }

  .hero-title {
    max-width: none;
    color: var(--text);
    font-size: clamp(3rem, 5.6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.99;
  }

  .hero-description {
    max-width: 38rem;
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: clamp(1rem, 1.7vw, 1.1875rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-7);
  }

  .hero-disciplines li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .hero-mark {
    width: min(100%, 300px);
    justify-self: end;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 816 / 669;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .hero {
      min-height: min(700px, 92svh);
      padding-block: calc(var(--nav-height) + var(--space-4)) var(--space-4);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .hero-mark {
      display: none;
    }

    .hero-title {
      max-width: 20ch;
      font-size: clamp(2.75rem, 7vw, 3.75rem);
    }

    .hero-eyebrow {
      margin-bottom: var(--space-3);
    }

    .hero-description {
      margin-top: var(--space-4);
    }

    .hero-actions {
      margin-top: var(--space-5);
    }

    .hero-disciplines {
      margin-top: var(--space-5);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 0;
    }
  }

  @media (max-width: 420px) {
    .desktop-break {
      display: none;
    }
  }
</style>
