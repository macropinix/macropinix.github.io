---
import { featuredProjects } from "../data/projects";
---

<section class="work">
  <div class="container">
    <h2 class="section-label">SELECTED WORK</h2>
    <p class="work-intro">
      Systems that have been built, tested, and made public.
    </p>

    <div class="work-list">
      {featuredProjects.map((project) => (
        <a href={`/work/${project.slug}`} class="project-card">
          <div class="project-header">
            <div class="project-meta">
              <span class="project-name">{project.name}</span>
              <span class="project-tagline">{project.tagline}</span>
            </div>
            <span class="project-arrow">INSPECT →</span>
          </div>
          <p class="project-description">{project.description}</p>
          <div class="project-footer">
            <ul class="project-tech" role="list">
              {project.technologies.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    padding: var(--space-9) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .work-intro {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: var(--space-7);
    max-width: 32rem;
  }

  .work-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .project-card {
    display: block;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-layer);
    transition: border-color var(--duration-fast) ease, background var(--duration-fast) ease;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    border-color: var(--blue-deep);
    background: var(--bg-elevated);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-3);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .project-name {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  .project-tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .project-arrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--signal);
    opacity: 0.7;
    transition: opacity var(--duration-fast) ease;
  }

  .project-card:hover .project-arrow {
    opacity: 1;
  }

  .project-description {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    max-width: 48rem;
  }

  .project-footer {
    display: flex;
    justify-content: flex-end;
  }

  .project-tech {
    display: flex;
    gap: var(--space-2);
  }

  .project-tech li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }
</style>
